# Optional. Web app URL of the Google Apps Script in stats/apps-script.gs (see stats/README.md).
# Leave empty to disable usage statistics completely (no network calls, no privacy UI).
VITE_STATS_URL=

# Optional. WhatsApp number that receives paper-planner orders from the #/shop page, international format, digits only
# (e.g. 201234567890). Leave empty and the order sheet shows a notice and opens nothing.
VITE_WHATSAPP_NUMBER=
